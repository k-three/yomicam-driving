rules_version = '2';

/**
 * 権限の分け方
 *
 *   運転手  … 運転手用アカウント（パスワードのみでログイン）。
 *             記録の追加と、**当日の記録**の修正・削除ができる。
 *             前日以前の記録は読めるだけで、直せない。
 *   管理者  … 管理者用アカウント。さらに admins に自分の uid の文書がある人だけ。
 *             すべての記録の修正・削除、マスタの変更ができる。
 *
 * 「当日だけ直せる」線を引いているのは、運転手が自分の打ち間違いをその場で
 * 直せるようにしつつ、月次で提出したあとの帳簿が動かないようにするため。
 * 判定には記録が持つ ymd（20260908 のような数値）を使う。日本時間で数えるので、
 * サーバ時刻に9時間足してから比べる。
 *
 * パスワードは Firebase 側で照合されるので、ここでは「ログインできた人」を
 * 信頼してよい。匿名ログインは明示的に締め出してある（Authentication で
 * 匿名を無効にしていても、設定の取り違えで開いてしまう事故を防ぐため）。
 *
 * 運転手は全員が1つのアカウントを共有する。したがって createdBy は
 * 「誰が」ではなく「運転手アプリからか管理画面からか」を示す記録として残る。
 * 誰が運転したかは、記録そのものの driver 欄が持つ。
 */
service cloud.firestore {
  match /databases/{database}/documents {

    // 匿名ログインは通さない。読み書きとも、必ずパスワードを通った人だけ
    function member() {
      return request.auth != null
        && request.auth.token.firebase.sign_in_provider == 'password';
    }
    function isAdmin() {
      return member() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // 日本時間の今日。20260908 のような数値にして比べる
    function jst() { return request.time + duration.value(9, 'h'); }
    function todayNum() { return jst().year() * 10000 + jst().month() * 100 + jst().day(); }
    function pad(n) { return n < 10 ? '0' + string(n) : string(n); }
    function todayStr() { return string(jst().year()) + '-' + pad(jst().month()) + '-' + pad(jst().day()); }
    // ymd を持たせる前に作られた記録もあるので、日付の文字列でも見る
    function isToday() {
      return resource.data.get('ymd', 0) == todayNum()
        || resource.data.get('date', '') == todayStr();
    }
    // 日付を後から動かせないようにする（別の月へ付け替えるのを防ぐ）
    function sameDay() {
      return request.resource.data.get('ymd', 0) == resource.data.get('ymd', 0)
        && request.resource.data.get('date', '') == resource.data.get('date', '');
    }

    // 管理者の名簿。追加は Firebase コンソールから手で行う（誰も自分で昇格できない）
    match /admins/{uid} {
      allow read: if member();
      allow write: if false;
    }

    // マスタ（運転者・車両・拠点・確認者・学校）
    match /config/{doc} {
      allow read: if member();
      allow write: if isAdmin();
    }

    match /trips/{id} {
      allow read: if member();
      // 運転手アプリからの新規は、当日・運行中としてしか作れない。
      // 過去日の後付けは管理者のみ
      allow create: if isAdmin()
        || (member() && request.resource.data.status == 'running'
            && request.resource.data.createdBy == request.auth.uid
            && request.resource.data.ymd == todayNum());
      // 運転手が直せるのは当日の記録だけ。日付は動かせない
      allow update: if isAdmin() || (member() && isToday() && sameDay());
      // 運行の取り消し。誤って記録したものを運転手が自分で消せるようにする。
      // 当日ぶんに限る（前日以前の削除は管理者のみ）
      allow delete: if isAdmin() || (member() && isToday());
    }

    match /alcohol/{id} {
      allow read: if member();
      allow create: if isAdmin()
        || (member() && request.resource.data.createdBy == request.auth.uid
            && request.resource.data.ymd == todayNum());
      // 誤タップの取消と直し。前日以前の記録簿は管理者だけが触れる
      allow update: if isAdmin() || (member() && isToday() && sameDay());
      allow delete: if isAdmin() || (member() && isToday());
    }
  }
}
